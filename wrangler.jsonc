{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umrah-taxi-web",
  "main": "worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": "./out"
  }
}